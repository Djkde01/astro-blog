---
import { Picture } from "astro:assets";
import { resolveImage } from "../js/images";
import { formatDate } from "../js/utils";
import type { Post } from "../types/posts";

const { relatedPosts } = Astro.props;
---

{
  relatedPosts.map((post: Post) => (
    <li class="post">
      <div class="text">
        <h3 class="h4">
          <a href={post.url}>{post.frontmatter.title}</a>
        </h3>
        <p>{post.frontmatter.description}</p>
        <small>
          <a href={`/about`}>Sergio Estrella</a> - {formatDate(post.frontmatter.date)}
        </small>
      </div>
      <a href={post.url} aria-hidden="true" tabindex="-1">
        <Picture
          src={resolveImage(post.frontmatter.image.src)}
          alt=""
          width="120"
          height="75"
          widths={[120, 240]}
          sizes="120px"
          formats={["avif"]}
          fallbackFormat="webp"
          quality={60}
        />
      </a>
    </li>
  ))
}
