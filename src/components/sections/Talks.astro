---
import Card from "../Card.astro";
import Section from "../Section.astro";
import { resolveImage } from "../../js/images";
import { findPost, formatTalkDate, isUpcoming } from "../../js/utils";
import type { Post } from "../../types/posts";
import type { AboutPage, Talk } from "../../types/sections";

interface Props {
  talks: Talk[];
  labels: AboutPage["talks"];
  // From formatBlogPosts, to resolve each talk's post and cover.
  posts: Post[];
}

const { talks, labels, posts } = Astro.props;
const newestFirst = talks.toSorted((a, b) => b.date.localeCompare(a.date));
// The year chips, newest first; a filter needs at least two years to choose between.
const years = [...new Set(newestFirst.map(({ date }) => date.slice(0, 4)))];
---

{
  newestFirst.length > 0 && (
    <Section class="talks section-accent" icon={labels.icon} title={labels.title} level={1}>
      {years.length > 1 && (
        <div class="year-filter chips" role="group" aria-label={labels.filter.label} hidden>
          <button type="button" class="chip" data-year="" aria-pressed="true">
            {labels.filter.all}
          </button>
          {years.map((year) => (
            <button type="button" class="chip" data-year={year} aria-pressed="false">
              {year}
            </button>
          ))}
        </div>
      )}
      <div class="card-grid">
        {newestFirst.map((talk) => {
          const post = talk.post ? findPost(posts, talk.post) : undefined;
          const image = post ? resolveImage(post.frontmatter.image.src) : talk.image && resolveImage(talk.image);
          const ctas = [
            { text: labels.links.registration, href: talk.registration, icon: "mdi:ticket-outline" },
            { text: labels.links.slides, href: talk.slides, icon: "mdi:presentation" },
            { text: labels.links.recording, href: talk.recording, icon: "mdi:play-circle-outline" },
            { text: labels.links.post, href: post?.url, icon: "mdi:text-box-outline" },
          ].filter((cta): cta is { text: string; href: string; icon: string } => Boolean(cta.href));
          return (
            <Card
              level={2}
              title={talk.title}
              tag={isUpcoming(talk) ? labels.upcoming : talk.date.slice(0, 4)}
              description={[talk.event, formatTalkDate(talk.date), talk.place, talk.language].join(" · ")}
              image={image || undefined}
              imageAlt={post ? post.frontmatter.image.alt : talk.title}
              ctas={ctas}
              data-year={talk.date.slice(0, 4)}
            />
          );
        })}
      </div>
    </Section>
  )
}

<script>
  // The year chips show only that year's talks. Without JavaScript the chips stay hidden and every talk shows.
  for (const filter of document.querySelectorAll<HTMLElement>(".year-filter")) {
    const chips = filter.querySelectorAll<HTMLButtonElement>("button");
    const cards = filter.nextElementSibling!.querySelectorAll<HTMLElement>(".content-card");
    filter.hidden = false;
    filter.addEventListener("click", (event) => {
      const chosen = (event.target as Element).closest("button");
      if (!chosen) return;
      const year = chosen.dataset.year;
      chips.forEach((chip) => chip.setAttribute("aria-pressed", `${chip === chosen}`));
      cards.forEach((card) => (card.hidden = Boolean(year) && card.dataset.year !== year));
    });
  }
</script>
