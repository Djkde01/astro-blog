---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  icon: string;
  class: string;
  // 1 when the section is the whole page, as on /charlas and /comunidad.
  level?: 1 | 2;
}

const { title, icon, class: className, level = 2 } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
// The slot touches its neighbours: whitespace around it would add a space to the output.
---

<section class={`container ${className}`}>
  <span class="title">
    <Icon name={icon} width={40} height={40} />
    <Heading class="h2">{title}</Heading>
  </span><slot /></section>
