---
import Card from "./Card.astro";
import { resolveImage } from "../js/images";
import { projects } from "../data/projects";
import type { ProjectStatus } from "../types/sections";

const STATUS_LABELS: Record<ProjectStatus, string> = {
  deployed: "Publicado",
  development: "En desarrollo",
};
---

<div class="content">
  {
    projects.map(({ image, title, description, link, github, status }) => (
      <Card
        class="project-card"
        tag={STATUS_LABELS[status]}
        tagClass={`project-tag project-${status}`}
        image={resolveImage(image)}
        imageAlt={title}
        title={title}
        description={description}
        ctas={[
          ...(github ? [{ text: "Código", href: github, icon: "mdi:github" }] : []),
          ...(link ? [{ text: "Proyecto", href: link, icon: "mdi:open-in-new" }] : []),
        ]}
      />
    ))
  }
</div>

<script>
  import { revealCards } from "../js/motion";
  revealCards("article.project-card");
</script>
