---
import { slugify, formatDate } from "../js/utils";
import { Picture } from "astro:assets";
import { resolveImage } from "../js/images";

const { category, title, date, image } = Astro.props;
---

<header>
  <Picture
    src={resolveImage(image.src)}
    alt={image.alt}
    width="1200"
    height="550"
    widths={[640, 1280]}
    sizes="100vw"
    formats={["avif"]}
    fallbackFormat="webp"
    class="hero-image"
    loading="eager"
    fetchpriority="high"
    quality={60}
  />
  <h2 class="h2">{title}</h2>
  <p><a href={`/about`}>Sergio Estrella</a> - {formatDate(date)}</p>
  <div class="container">
    <small
      ><a href={`/category/${slugify(category)}`} class="badge">{category}</a
      ></small
    >
  </div>
</header>
