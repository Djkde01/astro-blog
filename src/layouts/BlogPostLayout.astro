---
import "../styles/global.css";

import MainLayout from "./MainLayout.astro";
import PostHeader from "../components/PostHeader.astro";
import { formatBlogPosts, selectRelatedPosts, slugify } from "../js/utils";
import RelatedPosts from "../components/RelatedPosts.astro";

const { frontmatter, url } = Astro.props;

const { title, description, date, category, image } = frontmatter;

const allPosts = import.meta.glob("../pages/blog/*.md", {
  eager: true, // This ensures we get the module content directly
});
const formattedPosts = await formatBlogPosts(allPosts);

const { posts: relatedPosts, sameCategory } = selectRelatedPosts(formattedPosts, { url, frontmatter });
---

<MainLayout
  title={title + " - Sergio Estrella"}
  {description}
  image={frontmatter.image}
  {frontmatter}
  robots={frontmatter.robots}
>
  <PostHeader {title} {description} {date} {category} {image} />
  <div class="post-content">
    <div class="content">
      <slot />
    </div>
    <aside class="post-footer" aria-label="Sigue leyendo">
      <small>
        <a href={`/category/${slugify(category)}`} class="badge">{category}</a>
      </small>
      {
        relatedPosts.length > 0 && (
          <section aria-labelledby="related-posts-title">
            <h2 id="related-posts-title" class="h3">
              {sameCategory ? "Artículos relacionados" : "Más artículos"}
            </h2>
            <ul class="related-posts">
              <RelatedPosts {relatedPosts} />
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</MainLayout>
