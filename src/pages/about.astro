---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import MainLayout from "../layouts/MainLayout.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import Projects from "../components/Projects.astro";
import Section from "../components/Section.astro";
import Clients from "../components/sections/Clients.astro";
import Community from "../components/sections/Community.astro";
import Talks from "../components/sections/Talks.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import profile from "../assets/images/profile.webp";
import { about } from "../data/about";
import { clients } from "../data/clients";
import { community } from "../data/community";
import { experience } from "../data/experience";
import { services } from "../data/services";
import { talks } from "../data/talks";
import { testimonials } from "../data/testimonials";
import { formatBlogPosts, getExperienceInYears, published } from "../js/utils";
import type { Post } from "../types/posts";

const { intro, findMe } = about;
const years = `${getExperienceInYears()}`;
// Talks and community events link to posts; drafts show only under `astro dev`.
const posts: Post[] = await formatBlogPosts(import.meta.glob("./blog/*.md", { eager: true }));
const dev = import.meta.env.DEV;
---

<MainLayout title={about.title}>
  <section class="about-band">
    <div class="container about">
      <Picture
        src={profile}
        alt={intro.photoAlt}
        width="300"
        height="300"
        widths={[300, 600]}
        sizes="300px"
        formats={["avif"]}
        fallbackFormat="webp"
        quality={70}
        loading="eager"
        fetchpriority="high"
      />
      <div class="content">
        <h1>{intro.greeting} <span aria-hidden="true">{intro.greetingEmoji}</span></h1>
        {
          intro.paragraphs.map((segments) => (
            <p>
              {segments.map(({ text, highlight }) => {
                const filled = text.replaceAll("{years}", years);
                return highlight ? <span class="focus-primary">{filled}</span> : filled;
              })}
            </p>
          ))
        }
      </div>
    </div>
  </section>
  <Section class="encuentrame" icon={findMe.icon} title={findMe.title}>
    <ul class="find-me">
      {
        findMe.links.map(({ network, handle, href, icon }) => (
          <li>
            <a href={href}>
              <span class="icon-box"><Icon name={icon} aria-hidden="true" /></span>
              <span class="text">
                <small>{network}</small>
                <strong>{handle}</strong>
              </span>
              <Icon name="mdi:arrow-top-right" class="arrow" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
  <Section class="services" icon={about.services.icon} title={about.services.title}>
    <ul class="service-cards">
      {
        services.map(({ icon, title, description }) => (
          <li>
            <span class="icon-box"><Icon name={icon} aria-hidden="true" /></span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))
      }
    </ul>
  </Section>
  <Section class="experience" icon={about.experience.icon} title={about.experience.title}>
    <ol>
      {
        experience.map((item) => (
          <li>
            <ExperienceItem {...item} />
          </li>
        ))
      }
    </ol>
  </Section>
  <Talks talks={published(talks, dev)} labels={about.talks} posts={posts} />
  <Community community={published(community, dev)} labels={about.community} posts={posts} />
  <Clients clients={published(clients, dev)} labels={about.clients} />
  <Testimonials testimonials={published(testimonials, dev)} labels={about.testimonials} />
  <Section class="projects" icon={about.projects.icon} title={about.projects.title}>
    <Projects />
  </Section>
</MainLayout>
