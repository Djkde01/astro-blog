---
import { Picture } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import PostCard from "../components/PostCard.astro";
import Link from "../components/Link.astro";
import { Icon } from "astro-icon/components";
import profile from "../assets/images/profile.webp";
import { experience } from "../data/experience";
import { landing } from "../data/landing";
import { formatBlogPosts, getExperienceInYears, selectNow } from "../js/utils";
import type { Post } from "../types/posts";

const allPosts = import.meta.glob("./blog/*.md", {
  eager: true, // This ensures we get the module content directly
});

const posts: Post[] = await formatBlogPosts(allPosts);
const { hero, now, metrics, latestPosts } = landing;
const current = selectNow(experience, now);
const talks = posts.filter((post) => post.frontmatter.category === metrics.talksCategory).length;
const stats = [
  { value: `${talks}`, label: metrics.talks, highlight: true },
  { value: `+${getExperienceInYears()}`, label: metrics.years, highlight: false },
  { value: `${posts.length}`, label: metrics.posts, highlight: false },
];
---

<MainLayout title={landing.title}>
  <section class="hero">
    <div class="container">
      <div class="intro">
        <Picture
          src={profile}
          alt={hero.photoAlt}
          width="300"
          height="300"
          widths={[300, 600]}
          sizes="300px"
          formats={["avif"]}
          fallbackFormat="webp"
          quality={70}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="content">
        <h1 class="intro" style="--step: 1">{hero.name}</h1>
        <p class="role intro" style="--step: 2">{hero.role}</p>
        <p class="value intro" style="--step: 3">{hero.value}</p>
        <div class="actions intro" style="--step: 4">
          {
            hero.buttons.map(({ text, href, variant, icon }) => (
              <Link
                text={text}
                href={href}
                style="primary"
                icon={icon}
                isFilled={variant === "solid"}
                borderVisible={variant === "outline"}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section class="now">
    <div class="container">
      <span class="label">{now.label}</span>
      <p>
        {current.text}
        {
          current.link && (
            <a href={current.link.href}>
              {current.link.text}
              <Icon name="mdi:arrow-right" aria-hidden="true" />
            </a>
          )
        }
      </p>
    </div>
  </section>
  <section class="container metrics" aria-label={metrics.label}>
    <ul>
      {
        stats.map(({ value, label, highlight }) => (
          <li class:list={{ highlight }}>
            <strong>
              <span class="count" aria-hidden="true">{value}</span>
              <span class="visually-hidden">{value}</span>
            </strong>
            <span class="label">{label}</span>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="container">
    <h2 class="h2">{latestPosts.title}</h2>
    <div class="post-container">
      {
        posts
          .slice(0, latestPosts.count)
          .map((post) => (
            <PostCard
              frontmatter={post.frontmatter}
              url={post.url}
              tagType="h3"
            />
          ))
      }
    </div>
  </section>
</MainLayout>

<script>
  // Counts each metric up from 0 once the metrics scroll into view. Only the visible copy of each
  // number moves: screen readers read a hidden copy that always holds the final value, and the
  // HTML keeps the final values for crawlers and for readers without JavaScript or with reduced motion.
  const numbers = [...document.querySelectorAll<HTMLElement>("section.metrics .count")];
  if (numbers.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const DURATION = 400;
    const STAGGER = 120;
    const counters = numbers.map((number) => {
      const [, prefix = "", digits = "0"] = number.textContent!.trim().match(/^(\D*)(\d+)$/) ?? [];
      const show = (value: number) => (number.textContent = `${prefix}${value}`);
      show(0);
      return { show, target: Number(digits) };
    });
    const count = ({ show, target }: (typeof counters)[number], delay: number) => {
      let start: number | undefined;
      const step = (time: number) => {
        start ??= time + delay;
        const progress = Math.min(Math.max((time - start) / DURATION, 0), 1);
        show(Math.round(target * (1 - (1 - progress) ** 3)));
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      counters.forEach((counter, index) => count(counter, index * STAGGER));
    });
    observer.observe(numbers[0].closest("section")!);
  }
</script>
