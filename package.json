{
  "name": "djkde-blog-astro",
  "type": "module",
  "version": "0.0.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "error"
    }
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "node scripts/require-pnpm.mjs && astro dev",
    "start": "node scripts/require-pnpm.mjs && astro dev",
    "build": "node scripts/require-pnpm.mjs && astro build",
    "preview": "node scripts/require-pnpm.mjs && astro preview",
    "astro": "node scripts/require-pnpm.mjs && astro",
    "check": "node scripts/require-pnpm.mjs && astro check",
    "lint": "node scripts/require-pnpm.mjs && eslint .",
    "test": "node scripts/require-pnpm.mjs && node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "node scripts/require-pnpm.mjs && bash scripts/e2e-gate.sh --all"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/montserrat": "^5.0.17",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/json": "^2.2.306",
    "@justinribeiro/lite-youtube": "^1.7.1",
    "astro": "^5.16.6",
    "astro-icon": "^1.1.5",
    "postcss": "^8.4.31",
    "postcss-preset-env": "^9.1.4",
    "sanitize-html": "^2.11.0",
    "sharp": "^0.32.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^7.3.0"
  }
}
